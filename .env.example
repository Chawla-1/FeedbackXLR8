# FeedbackXLR8 Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Authentication & Security
# ============================================
# IMPORTANT: Change these in production!
# Use strong passwords and store securely
AUTH_ADMIN_EMAIL=admin@feedbackxlr8.io
AUTH_ADMIN_PASSWORD=change_this_strong_password_123!
AUTH_ADMIN_NAME=Admin User
AUTH_ADMIN_ROLE=Admin

AUTH_DEMO_EMAIL=demo@feedbackxlr8.io
AUTH_DEMO_PASSWORD=change_this_demo_password_456!
AUTH_DEMO_NAME=Demo Analyst
AUTH_DEMO_ROLE=Analyst

AUTH_FOUNDER_EMAIL=founder@company.io
AUTH_FOUNDER_PASSWORD=change_this_founder_password_789!
AUTH_FOUNDER_NAME=Founder
AUTH_FOUNDER_ROLE=Founder

# Session secret (generate random string for production)
SESSION_SECRET_KEY=your-random-secret-key-here-minimum-32-characters

# ============================================
# Google Play Store API (Optional)
# ============================================
# Path to Google Service Account JSON file
# Download from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/your/service-account.json
GOOGLE_PLAY_PACKAGE_NAME=com.your.app

# ============================================
# Application Settings
# ============================================
APP_NAME=FeedbackXLR8
APP_ENV=development
# Options: development, staging, production

# Enable/disable features
ENABLE_LOGIN=true
ENABLE_GOOGLE_PLAY_SYNC=false
ENABLE_SURGE_SIMULATION=true

# ============================================
# Data Paths
# ============================================
DATA_DIR=data
APPS_DIR=data/apps
BENCHMARK_DIR=benchmark

# ============================================
# Model Configuration
# ============================================
# Sentiment engine version: v2 (lexicon) or v3 (transformer)
SENTIMENT_ENGINE=v3

# DistilBERT: 40% smaller, 60% faster than BERT, 97% performance (recommended for production)
# Size: ~268MB (downloads once, cached locally)
# Speed: 10-15 reviews/sec (vs 2 reviews/sec with RoBERTa-base)
# Alternatives:
#   - distilbert-base-uncased-finetuned-sst-2-english (DistilBERT, fastest, 268MB)
#   - cardiffnlp/twitter-roberta-base-sentiment-latest (RoBERTa, slower, 500MB)
#   - j-hartmann/sentiment-roberta-large-english-3-classes (highest accuracy, slowest, 1.4GB)
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Use transformer for sentiment (true = 97% BERT accuracy, false = 68.7% lexicon)
USE_TRANSFORMER=true

# Theme clustering
THEME_ENGINE=v3

# Embedding model for semantic clustering (384 dimensions)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# Performance Tuning
# ============================================
# Maximum reviews to process in single batch
MAX_BATCH_SIZE=10000

# Cache settings
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ============================================
# Monitoring & Alerting
# ============================================
# Z-score threshold for spike detection (default: 2.5)
ALERT_Z_SCORE_THRESHOLD=2.5

# PSI drift thresholds
DRIFT_WARNING_THRESHOLD=0.10
DRIFT_CRITICAL_THRESHOLD=0.25

# ============================================
# Background Scheduler (for live apps)
# ============================================
# Enable automatic periodic review syncing
ENABLE_SCHEDULER=true

# How often to fetch new reviews (in minutes)
SYNC_INTERVAL_MINUTES=5

# Use transformer engine for higher accuracy (recommended)
SCHEDULER_USE_TRANSFORMER=true

# Generate embeddings for dynamic theme clustering
SCHEDULER_ENABLE_EMBEDDINGS=true

# Enable DBSCAN clustering for advanced theme discovery
SCHEDULER_ENABLE_CLUSTERING=true

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/feedbackxlr8.log
