      "mode": "No Lexicon Signal",
      "observation": "Short reviews like 'Okay' or 'Fine' with no strong sentiment words default to neutral with low confidence (0.35)."
    },
    {
      "mode": "Rating-Text Disagreement",
      "observation": "~5-10% of reviews have text sentiment that contradicts the star rating (e.g., 5-star but text complains). These are the highest-value mixed-sentiment cases."
    }
